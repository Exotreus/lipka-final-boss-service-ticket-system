  "components": {
    "schemas": {
      "ServiceTicket": {
        "required": [
          "category",
          "description",
          "email",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "description": {
            "minLength": 10,
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/ServiceTicketCategories"
          },
          "createTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ServiceTicketCategories": {
        "enum": [
          "Misc",
          "Hardware",
          "Software",
          "Network"
        ],
        "type": "string"
      }
    }
